# Copy this file to .env and fill in the values.
# .env is git-ignored; never commit real credentials.

# ---------------------------------------------------------------
# Local infrastructure (docker compose)
# ---------------------------------------------------------------
POSTGRES_USER=aeris
POSTGRES_PASSWORD=
POSTGRES_DB=aeris
# Host ports (change if already in use, e.g. by a locally installed Postgres)
POSTGRES_PORT=5433
REDIS_PORT=6379

# Used when running the backend outside Docker (uv run ...).
# Inside Docker these are set by docker-compose.yml to the db/redis services.
DATABASE_URL=postgresql+psycopg://aeris:<POSTGRES_PASSWORD>@localhost:5433/aeris
REDIS_URL=redis://localhost:6379/0
DATA_DIR=../data
# Tracking-result cache lifetime in seconds (AusPost allows 10 requests/minute)
TRACKING_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------
# Australia Post / StarTrack (Shipping & Tracking API - testbed)
# Auth: HTTP Basic (API key as username, password as password)
#       + "Account-Number" header
# Docs: https://developers.auspost.com.au/apis/shipping-and-tracking/getting-started
# ---------------------------------------------------------------
AUSPOST_BASE_URL=https://digitalapi.auspost.com.au/test/shipping/v1
AUSPOST_API_KEY=
AUSPOST_PASSWORD=

# One account number per product family. StarTrack tracking numbers
# (e.g. 2FWZ..., RBXZ...) use the StarTrack account.
AUSPOST_ACCOUNT_NUMBER_DOMESTIC=
AUSPOST_ACCOUNT_NUMBER_SAME_DAY=
AUSPOST_ACCOUNT_NUMBER_STARTRACK=
AUSPOST_ACCOUNT_NUMBER_ON_DEMAND=

# StarTrack product used for shipment-fee quotes (EXP = Express)
STARTRACK_PRODUCT_ID=EXP

# ---------------------------------------------------------------
# TNT - Secured Weblinking (consignment tracking)
# Legacy consignment-history weblink; the connote is the whole query string (HTML response)
# ---------------------------------------------------------------
TNT_TRACKING_URL=https://www.tntexpress.com.au/InterAction/ASPs/CnmHxAS.asp
TNT_WEBLINK_USERNAME=
TNT_WEBLINK_PASSWORD=

# ---------------------------------------------------------------
# TNT - UAT (domestic, test environment only)
# Used for Rated Transit Times (RTT) quotes - shipping fee bonus
# ---------------------------------------------------------------
TNT_RTT_URL=https://uat.tntexpress.com.au/rttnet/inputrequest.aspx
TNT_UAT_USERNAME=
TNT_UAT_PASSWORD=
TNT_UAT_ACCOUNT=
# TNT service used for shipment-fee quotes (76 = Road Express)
TNT_SERVICE_CODE=76
# RTT prices are treated as ex-GST; set true if your rates already include GST
TNT_PRICE_INCLUDES_GST=false

# ---------------------------------------------------------------
# App settings
# ---------------------------------------------------------------
# The brief says "2111 (Ryde, NSW)", but 2111 is Gladesville (Ryde is 2112).
# Carriers validate suburb + postcode together, so GLADESVILLE is used.
ORIGIN_POSTCODE=2111
ORIGIN_SUBURB=GLADESVILLE
ORIGIN_STATE=NSW
# Carton assumptions for shipment-fee quotes
PACKING_FACTOR=1.25
PACKAGING_WEIGHT_KG=0.3
